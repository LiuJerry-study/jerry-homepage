# 写作后台的环境变量示例。
# 用法：复制成一份自己的（别提交），启动前 source 进去：
#   set -a; . ./admin/admin.env; set +a; node admin/server.mjs
# 或者直接写进 systemd 的 Environment= 里（见 DEPLOY.md）。

# 必填：登录密码。不设就不启动。
ADMIN_PASSWORD=换成一个只有你知道的密码

# 监听地址与端口。默认只监听本机，外面挂 nginx 反代。
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787

# 用 HTTPS 访问后台时打开（cookie 加 Secure）
ADMIN_SECURE=0

# 登录有效期（小时），默认 168 = 7 天
ADMIN_SESSION_HOURS=168
