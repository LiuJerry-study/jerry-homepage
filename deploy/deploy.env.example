# ==========================================================================
# 部署配置示例
# 复制成 deploy/deploy.env 再改（deploy.env 已在 .gitignore 里，不会进仓库）
# ==========================================================================

# 服务器地址，ssh 能连上就行
DEPLOY_TARGET=root@1.2.3.4

# 服务器上的站点目录（要和 nginx 里的 root 一致）
DEPLOY_PATH=/var/www/personal-site

# 如果不使用默认的 22 端口，可以在这里写（deploy.sh 会用 ssh 配置）
# DEPLOY_PORT=22
